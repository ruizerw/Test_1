#region Prolog

if (parm_typalloc @='ALLOC_TO');
   vdimname='DIM_Allocation_to';
else;
   vdimname='DIM_Allocation';
endif;

# Création ou suppression de la dimension
if (dimensionexists(vdimname) = 0);
dimensioncreate(vdimname);
endif;

# Création de l'attribut Destination FR (Alias)
attrdelete(vdimname, 'Destination FR');
attrinsert(vdimname, '', 'Destination FR', 'A');

# Création de l'attribut Société (Attribut)
attrdelete(vdimname, 'Company');
attrinsert(vdimname, '', 'Company', 'S');

# Création de l'attribut Allocation EN (Alias)
attrdelete(vdimname, 'Allocation EN');
attrinsert(vdimname, '', 'Allocation EN', 'A');

# Création de l'attribut Centro de custo POR (Alias)
attrdelete(vdimname, 'Centro de custo POR');
attrinsert(vdimname, '', 'Centro de custo POR', 'A');

# Création de l'attribut Unit of Work
attrdelete(vdimname, 'Unit of Work');
attrinsert(vdimname, '', 'Unit of Work', 'S');

# Création de l'attribut LEVEL1
attrdelete(vdimname, 'LEVEL1');
attrinsert(vdimname, '', 'LEVEL1', 'S');

# Création de l'attribut Allocation
attrdelete(vdimname, 'Allocation');
attrinsert(vdimname, '', 'Allocation', 'S');

# Création de l'attribut Country
attrdelete(vdimname, 'Country');
attrinsert(vdimname, '', 'Country', 'S');

# Création de l'attribut SK_Country
attrdelete(vdimname, 'SK_Country');
attrinsert(vdimname, '', 'SK_Country', 'S');

# Création de l'attribut Simple_Description (Alias)
attrdelete(vdimname, 'Simple_Description');
attrinsert(vdimname, '', 'Simple_Description', 'A');

# Création de l'attribut Status
attrdelete(vdimname, 'Status');
attrinsert(vdimname, '', 'Status', 'S');

# Création de l'attribut Type_Alloc
attrdelete(vdimname, 'Type_Alloc');
attrinsert(vdimname, '', 'Type_Alloc', 'S');

# Création de l'attribut Department
attrdelete(vdimname, 'Department');
attrinsert(vdimname, '', 'Department', 'S');


dimensiondeleteallelements(vdimname);

dimensionsortorder(vdimname, 'ByInput', 'Ascending', 'ByHierarchy', 'Ascending');

#endregion
#region Metadata

