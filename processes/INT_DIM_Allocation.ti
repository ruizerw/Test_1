#region Epilog

## Création sous-élément niveau 0  #############################
## Dimension Destination_Analytique #############################
if(parm_typalloc @= 'ALLOC_TO');
   sDimName='Dim_Allocation_to';
else;
   sDimName='Dim_Allocation';
endif;
sTmpName = 'Niveau_0';

# Suppression du sous-ensemble temporaire
if( SubsetExists( sDimName, sTmpName) = 1) ;
  SubsetDestroy( sDimName, sTmpName);
endif;

# Creation du sous-ensemble Niveau 0
#SubsetCreate( sDimName, sTmpName);

#i = 1;
#j = 1;

#n = DIMSIZ( sDimName);
#while( i <= n) ;
#  sElt = DIMNM( sDimName, i);
#  if( ELLEV( sDimName, sElt) = 0) ;
#    SubsetElementInsert( sDimName, sTmpName, sElt, j);
#   j = j + 1;
#  endif;
#  i = i + 1;
#end;


SubsetCreatebyMDX(sTmpName, '{TM1SORT( {TM1FILTERBYLEVEL( {TM1SUBSETALL([' | sDimName | '] )}, 0)}, ASC)} ' );

sElt = SubsetGetElementName(sDimName, sTmpName, 1);
SubsetElementInsert(sDimName, sTmpName, sElt, 1);
SubsetElementDelete(sDimName, sTmpName, 1);


## Création Vue Allocation Active  #############################
## Dimension Destination_Analytique #############################

sTmpName = 'Active_Allocation';

# Suppression du sous-ensemble temporaire
if( SubsetExists( sDimName, sTmpName) = 1) ;
  SubsetDestroy( sDimName, sTmpName);
endif;

# Creation du sous-ensemble Niveau 0
SubsetCreate( sDimName, sTmpName);

i = 1;
k = DIMSIZ( sDimName);
      while( i <= k) ;
          sElt = DIMNM( sDimName, i);
             if(attrs(sDimName, sElt, 'Status') @= ' ');
                     SubsetElementInsert( sDimName, sTmpName, sElt, 1);
            endif;
         i = i + 1;
      end;


## Création des sous-éléments pour chaque société - Niveau hiérarchique #############################
## Dimension Destination_Analytique #############################
sDimNameSrc = 'Company';

i = 1;

n = DIMSIZ(sDimNameSrc);
while( i <= n) ;
  sElt = DIMNM( sDimNameSrc, i);
  if( ELLEV( sDimNameSrc, sElt) = 0) ;

      vCosteSrc = attrs(sDimNameSrc, sElt, 'Company');
      sTmpName = 'K_'|vCosteSrc;

      # Suppression du sous-ensemble temporaire
      if( SubsetExists( sDimName, sTmpName) = 1);
          SubsetDestroy( sDimName, sTmpName);
      endif;

      # Creation du sous-ensemble Niveau 0
      SubsetCreate( sDimName, sTmpName);

      j = 1;
     m = 1;
      k = DIMSIZ( sDimName);
      while( j <= k) ;
          sElt = DIMNM( sDimName, j);
             if( vCosteSrc @= attrs(sDimName, sElt, 'Company'));
                     SubsetElementInsert( sDimName, sTmpName, sElt, m);
                     m = m + 1;
            endif;
         j = j + 1;
      end;

  endif;

  i = i + 1;
end;


## Création des sous-éléments pour chaque société - Niveau 0 #############################
## Dimension Destination_Analytique #############################
sDimNameSrc = 'Company';

i = 1;

n = DIMSIZ(sDimNameSrc);
while( i <= n) ;
  sElt = DIMNM( sDimNameSrc, i);
  if( ELLEV( sDimNameSrc, sElt) = 0) ;

      vCosteSrc = attrs(sDimNameSrc, sElt, 'Company');
      sTmpName = 'K_'|vCosteSrc|'0';

      # Suppression du sous-ensemble temporaire
      if( SubsetExists( sDimName, sTmpName) = 1);
          SubsetDestroy( sDimName, sTmpName);
      endif;

      # Creation du sous-ensemble Niveau 0
      SubsetCreate( sDimName, sTmpName);

      j = 1;
     m = 1;
      k = DIMSIZ( sDimName);
      while( j <= k) ;
          sElt = DIMNM( sDimName, j);
             if( ELLEV( sDimName, sElt) = 0) ;
                if( vCosteSrc @= attrs(sDimName, sElt, 'Company'));
                        SubsetElementInsert( sDimName, sTmpName, sElt, m);
                        m = m + 1;
               endif;
            endif;
         j = j + 1;
      end;

  endif;

  i = i + 1;
end;

#endregion