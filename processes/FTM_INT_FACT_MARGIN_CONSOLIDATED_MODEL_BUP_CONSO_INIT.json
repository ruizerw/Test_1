{
	"@type":"Process",
	"Name":"FTM_INT_FACT_MARGIN_CONSOLIDATED_MODEL_BUP_CONSO_INIT",
	"HasSecurityAccess":false,
	"Code@Code.link":"FTM_INT_FACT_MARGIN_CONSOLIDATED_MODEL_BUP_CONSO_INIT.ti",
	"DataSource":
	{
		"Type":"ODBC",
		"dataSourceNameForServer":"DWH_PROD",
		"dataSourceNameForClient":"DWH_PROD",
		"userName":"admin_DWH",
		"password":"",
		"query":"begin \r\nSELECT case when [FLAG_INTERCOMPANY] = 1 then 'I' else '' end as interco\r\n\t   , substring(cast(seq_month as varchar(6)), 1, 4) as anrec\r\n      ,substring(cast(seq_month as varchar(6)), 5, 2) as morec\r\n\t  ,so.COD_COMPANY as sk_soorg\r\n      ,concat('C-',co.COD_COUNTRY) as sk_nopayp\r\n      ,concat('MOD-',pm.[COD_PRODUCT_MODEL]) as sk_gnfctmd\r\n      ,ms.COD_COMPANY as sk_sofct\r\n      ,[QTY_MACHINE_INVOICED] as nmacv\r\n      ,[AMT_GROSS_SALES] as mtbrt\r\n      ,[AMT_DISCOUNT_INVOICE] as mtremf\r\n      ,[AMT_DISCOUNT_OTHER] as mtremhf\r\n      ,[AMT_WARRANTY_CREDIT] as mtavgar\r\n      ,[AMT_SHIPPING_PACKAGING] as mtporem\r\n      ,[AMT_PRC] as mtprc\r\n      ,[AMT_DB1] as mtdb1\r\n      ,[AMT_BE] as mtbe\r\n  FROM [KUHN_BI_DWH].[ACCOUNTING].[FACT_CONSOLIDATED_MARGIN] conso\r\nleft outer join common.dim_company so on conso.SEQ_COMPANY = so.seq_company\r\nleft outer join common.DIM_COUNTRY co on conso.SEQ_CUSTOMER_COUNTRY = co.SEQ_COUNTRY\r\nleft outer join common.DIM_PRODUCT_MODEL pm on conso.SEQ_PRODUCT_MODEL = pm.SEQ_PRODUCT_MODEL\r\nleft outer join common.DIM_company ms on conso.SEQ_COMPANY_MODEL = ms.SEQ_COMPANY\r\nend"
	},
