		"query":"SELECT pl.cod_product_line,\r\n       pl.lab_product_line_en,\r\n       pl.lab_product_line_fr,\r\n       pf.cod_product_family,\r\n       pf.lab_product_family_en,\r\n       pf.lab_product_family_fr,\r\n       ps.cod_product_subfamily,\r\n       ps.lab_product_subfamily_en,\r\n       ps.lab_product_subfamily_fr,\r\n       pm.COD_PRODUCT_MODEL,\r\n       pm.LAB_MODEL_EN,\r\n       pm.LAB_MODEL_FR,\r\n       pl.lab_product_line_pt,\r\n       pf.lab_product_family_pt,\r\n       ps.lab_product_subfamily_pt,\r\n       pm.LAB_MODEL_PT\r\nFROM common.dim_product_subfamily ps,\r\n     common.dim_product_family pf,\r\n     common.dim_product_line pl,\r\n     common.dim_product_model pm\r\nWHERE ps.seq_product_family = pf.seq_product_family\r\n      AND pf.seq_product_line = pl.seq_product_line\r\n      and pm.SEQ_PRODUCT_SUBFAMILY=ps.SEQ_PRODUCT_SUBFAMILY\r\nORDER BY pl.SORT_ORDER, pf.SORT_ORDER, ps.SORT_ORDER, pm.SORT_ORDER"
	},
