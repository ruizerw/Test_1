{
	"@type":"Process",
	"Name":"INT_DIM_Allocation",
	"HasSecurityAccess":false,
	"Code@Code.link":"INT_DIM_Allocation.ti",
	"DataSource":
	{
		"Type":"ODBC",
		"dataSourceNameForServer":"DWH_PROD",
		"dataSourceNameForClient":"DWH_PROD",
		"userName":"admin_DWH",
		"password":"",
		"query":"SELECT \r\nID_ALLOCATION,\r\nsubstring(ID_ALLOCATION, 1, charindex('-', id_allocation, 1)-1) as Coste,\r\nCOD_ALLOCATION,\r\ncase when COD_ALLOCATION in ('-1','-2') then '1-NA1' else COD_CLASSIFICATION_L1 end as COD_CLASSIFICATION_L1,\r\ncase when COD_ALLOCATION in ('-1','-2') then '2-NA2' else COD_CLASSIFICATION_L2 end as COD_CLASSIFICATION_L2,\r\ncase when COD_CLASSIFICATION_L3 is null then '' else COD_CLASSIFICATION_L3 end as COD_CLASSIFICATION_L3,\r\ncase when COD_CLASSIFICATION_L4 is null then '' else COD_CLASSIFICATION_L4 end as COD_CLASSIFICATION_L4,\r\ncase when COD_CLASSIFICATION_L5 is null then '' else COD_CLASSIFICATION_L5 end as COD_CLASSIFICATION_L5,\r\ncase when COD_CLASSIFICATION_L6 is null then '' else COD_CLASSIFICATION_L6 end as COD_CLASSIFICATION_L6,\r\ncase when COD_CLASSIFICATION_L7 is null then '' else COD_CLASSIFICATION_L7 end as COD_CLASSIFICATION_L7,\r\ncase when COD_CLASSIFICATION_L8 is null then '' else COD_CLASSIFICATION_L8 end as COD_CLASSIFICATION_L8,\r\ncase when COD_CLASSIFICATION_L9 is null then '' else COD_CLASSIFICATION_L9 end as COD_CLASSIFICATION_L9,\r\ncase when COD_CLASSIFICATION_L10 is null then '' else COD_CLASSIFICATION_L10 end as COD_CLASSIFICATION_L10,\r\ncase when COD_CLASSIFICATION_L11 is null then '' else COD_CLASSIFICATION_L11 end as COD_CLASSIFICATION_L11,\r\ncase when COD_CLASSIFICATION_L12 is null then '' else COD_CLASSIFICATION_L12 end as COD_CLASSIFICATION_L12,\r\ncase when COD_CLASSIFICATION_L13 is null then '' else COD_CLASSIFICATION_L13 end as COD_CLASSIFICATION_L13,\r\ncase when COD_CLASSIFICATION_L14 is null then '' else COD_CLASSIFICATION_L14 end as COD_CLASSIFICATION_L14,\r\ncase when COD_CLASSIFICATION_L15 is null then '' else COD_CLASSIFICATION_L15 end as COD_CLASSIFICATION_L15,\r\nLAB_ALLOCATION,\r\nLAB_CLASSIFICATION_L1_FR,\r\nLAB_CLASSIFICATION_L1_EN,\r\nLAB_CLASSIFICATION_L1_PT,\r\nLAB_CLASSIFICATION_L2_FR,\r\nLAB_CLASSIFICATION_L2_EN,\r\nLAB_CLASSIFICATION_L2_PT,\r\nLAB_CLASSIFICATION_L3_FR,\r\nLAB_CLASSIFICATION_L3_EN,\r\nLAB_CLASSIFICATION_L3_PT,\r\nLAB_CLASSIFICATION_L4_FR,\r\nLAB_CLASSIFICATION_L4_EN,\r\nLAB_CLASSIFICATION_L4_PT,\r\nLAB_CLASSIFICATION_L5_FR,\r\nLAB_CLASSIFICATION_L5_EN,\r\nLAB_CLASSIFICATION_L5_PT,\r\nLAB_CLASSIFICATION_L6_FR,\r\nLAB_CLASSIFICATION_L6_EN,\r\nLAB_CLASSIFICATION_L6_PT,\r\nLAB_CLASSIFICATION_L7_FR,\r\nLAB_CLASSIFICATION_L7_EN,\r\nLAB_CLASSIFICATION_L7_PT,\r\nLAB_CLASSIFICATION_L8_FR,\r\nLAB_CLASSIFICATION_L8_EN,\r\nLAB_CLASSIFICATION_L8_PT,\r\nLAB_CLASSIFICATION_L9_FR,\r\nLAB_CLASSIFICATION_L9_EN,\r\nLAB_CLASSIFICATION_L9_PT,\r\nLAB_CLASSIFICATION_L10_FR,\r\nLAB_CLASSIFICATION_L10_EN,\r\nLAB_CLASSIFICATION_L10_PT,\r\nLAB_CLASSIFICATION_L11_FR,\r\nLAB_CLASSIFICATION_L11_EN,\r\nLAB_CLASSIFICATION_L11_PT,\r\nLAB_CLASSIFICATION_L12_FR,\r\nLAB_CLASSIFICATION_L12_EN,\r\nLAB_CLASSIFICATION_L12_PT,\r\nLAB_CLASSIFICATION_L13_FR,\r\nLAB_CLASSIFICATION_L13_EN,\r\nLAB_CLASSIFICATION_L13_PT,\r\nLAB_CLASSIFICATION_L14_FR,\r\nLAB_CLASSIFICATION_L14_EN,\r\nLAB_CLASSIFICATION_L14_PT,\r\nLAB_CLASSIFICATION_L15_FR,\r\nLAB_CLASSIFICATION_L15_EN,\r\nLAB_CLASSIFICATION_L15_PT,\r\nCOD_COST_CENTER,\r\nCOD_TYPE,\r\nCOD_STATE,\r\nCOD_PRODUCTION_LINE,\r\nCOD_PRODUCTION_TYPE,\r\nCOD_INPUT_UNIT,\r\nconcat('X',cast(COD_ALLOCATION as char(12))) as COD_DEST_ANA,\r\ncase when COD_ALLOCATION between '5100' and '5999' then substring (COD_ALLOCATION,2,3) ELSE\r\ncase when substring(ID_ALLOCATION,1,1) ='G'/*Code société*/ and substring(cod_allocation,1,2)='50' then '112' ELSE\r\ncase when substring(ID_ALLOCATION,1,1) ='A'/*Code société*/ and COD_ALLOCATION='5075' then '106' else\r\ncase when DC.COD_COMPANY is null then '-1' else DC.COD_COUNTRY\r\nEND end end  end as 'country'\r\nFROM common.DIM_ALLOCATION DA\r\nleft outer JOIN common.DIM_COMPANY DC on substring(ID_ALLOCATION,1,1) = DC.COD_COMPANY\r\nwhere id_allocation not like 'null%'"
	},
