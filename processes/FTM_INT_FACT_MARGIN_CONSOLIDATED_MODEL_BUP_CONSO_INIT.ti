   cellputn(vMttPrec+MTREMHF, 'FTM_DATA_MARGIN_CONSOLIDATED_BY_MODEL_CONSO', sk_soorg, sk_sofct, 'AC'|anrec, morec, sk_nopayp, sk_gnfctmd, 'DISCOUNT_OFF_INVOICE');

   vMttPrec = cellgetn('FTM_DATA_MARGIN_CONSOLIDATED_BY_MODEL_CONSO', sk_soorg, sk_sofct, 'AC'|anrec, morec, sk_nopayp, sk_gnfctmd, 'WARRANTY');
   cellputn(vMttPrec+MTAVGAR, 'FTM_DATA_MARGIN_CONSOLIDATED_BY_MODEL_CONSO', sk_soorg, sk_sofct, 'AC'|anrec, morec, sk_nopayp, sk_gnfctmd, 'WARRANTY');

   vMttPrec = cellgetn('FTM_DATA_MARGIN_CONSOLIDATED_BY_MODEL_CONSO', sk_soorg, sk_sofct, 'AC'|anrec, morec, sk_nopayp, sk_gnfctmd, 'FREIGHT_PACKAGING');
   cellputn(vMttPrec+MTPOREM, 'FTM_DATA_MARGIN_CONSOLIDATED_BY_MODEL_CONSO', sk_soorg, sk_sofct, 'AC'|anrec, morec, sk_nopayp, sk_gnfctmd, 'FREIGHT_PACKAGING');

   vMttPrec = cellgetn('FTM_DATA_MARGIN_CONSOLIDATED_BY_MODEL_CONSO', sk_soorg, sk_sofct, 'AC'|anrec, morec, sk_nopayp, sk_gnfctmd, 'TOTAL_COST');
   cellputn(vMttPrec+MTPRC, 'FTM_DATA_MARGIN_CONSOLIDATED_BY_MODEL_CONSO', sk_soorg, sk_sofct, 'AC'|anrec, morec, sk_nopayp, sk_gnfctmd, 'TOTAL_COST');

   vMttPrec = cellgetn('FTM_DATA_MARGIN_CONSOLIDATED_BY_MODEL_CONSO', sk_soorg, sk_sofct, 'AC'|anrec, morec, sk_nopayp, sk_gnfctmd, 'DB1_COST');
   cellputn(vMttPrec+MTDB1, 'FTM_DATA_MARGIN_CONSOLIDATED_BY_MODEL_CONSO', sk_soorg, sk_sofct, 'AC'|anrec, morec, sk_nopayp, sk_gnfctmd, 'DB1_COST');

   vMttPrec = cellgetn('FTM_DATA_MARGIN_CONSOLIDATED_BY_MODEL_CONSO', sk_soorg, sk_sofct, 'AC'|anrec, morec, sk_nopayp, sk_gnfctmd, 'ENGINEERING_COST');
   cellputn(vMttPrec+MTBE, 'FTM_DATA_MARGIN_CONSOLIDATED_BY_MODEL_CONSO', sk_soorg, sk_sofct, 'AC'|anrec, morec, sk_nopayp, sk_gnfctmd, 'ENGINEERING_COST');

 endif;

else;

   vMttPrec = cellgetn('FTM_DATA_MARGIN_CONSOLIDATED_BY_MODEL_BUP', sk_soorg, sk_sofct, 'AC'|anrec, morec, sk_nopayp, sk_gnfctmd, 'GROSS_SALES');
   cellputn(vMttPrec+MTBRT, 'FTM_DATA_MARGIN_CONSOLIDATED_BY_MODEL_BUP', sk_soorg, sk_sofct, 'AC'|anrec, morec, sk_nopayp, sk_gnfctmd, 'GROSS_SALES');

   vMttPrec = cellgetn('FTM_DATA_MARGIN_CONSOLIDATED_BY_MODEL_BUP', sk_soorg, sk_sofct, 'AC'|anrec, morec, sk_nopayp, sk_gnfctmd, 'QTY_MACHINE');
   cellputn(vMttPrec+NMACV, 'FTM_DATA_MARGIN_CONSOLIDATED_BY_MODEL_BUP', sk_soorg, sk_sofct, 'AC'|anrec, morec, sk_nopayp, sk_gnfctmd, 'QTY_MACHINE');

   vMttPrec = cellgetn('FTM_DATA_MARGIN_CONSOLIDATED_BY_MODEL_BUP', sk_soorg, sk_sofct, 'AC'|anrec, morec, sk_nopayp, sk_gnfctmd, 'DISCOUNT_ON_INVOICE');
   cellputn(vMttPrec+MTREMF, 'FTM_DATA_MARGIN_CONSOLIDATED_BY_MODEL_BUP', sk_soorg, sk_sofct, 'AC'|anrec, morec, sk_nopayp, sk_gnfctmd, 'DISCOUNT_ON_INVOICE');

   vMttPrec = cellgetn('FTM_DATA_MARGIN_CONSOLIDATED_BY_MODEL_BUP', sk_soorg, sk_sofct, 'AC'|anrec, morec, sk_nopayp, sk_gnfctmd, 'DISCOUNT_OFF_INVOICE');
   cellputn(vMttPrec+MTREMHF, 'FTM_DATA_MARGIN_CONSOLIDATED_BY_MODEL_BUP', sk_soorg, sk_sofct, 'AC'|anrec, morec, sk_nopayp, sk_gnfctmd, 'DISCOUNT_OFF_INVOICE');

   vMttPrec = cellgetn('FTM_DATA_MARGIN_CONSOLIDATED_BY_MODEL_BUP', sk_soorg, sk_sofct, 'AC'|anrec, morec, sk_nopayp, sk_gnfctmd, 'WARRANTY');
   cellputn(vMttPrec+MTAVGAR, 'FTM_DATA_MARGIN_CONSOLIDATED_BY_MODEL_BUP', sk_soorg, sk_sofct, 'AC'|anrec, morec, sk_nopayp, sk_gnfctmd, 'WARRANTY');

   vMttPrec = cellgetn('FTM_DATA_MARGIN_CONSOLIDATED_BY_MODEL_BUP', sk_soorg, sk_sofct, 'AC'|anrec, morec, sk_nopayp, sk_gnfctmd, 'FREIGHT_PACKAGING');
   cellputn(vMttPrec+MTPOREM, 'FTM_DATA_MARGIN_CONSOLIDATED_BY_MODEL_BUP', sk_soorg, sk_sofct, 'AC'|anrec, morec, sk_nopayp, sk_gnfctmd, 'FREIGHT_PACKAGING');

   vMttPrec = cellgetn('FTM_DATA_MARGIN_CONSOLIDATED_BY_MODEL_BUP', sk_soorg, sk_sofct, 'AC'|anrec, morec, sk_nopayp, sk_gnfctmd, 'TOTAL_COST');
